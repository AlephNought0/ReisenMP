<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)/BepInEx/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)/BepInEx/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)/CasualtiesUnknown_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)/CasualtiesUnknown_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)/CasualtiesUnknown_Data/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyDebugFile" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Debug'">
    <Copy SourceFiles="$(TargetDir)ReisenMP.dll" DestinationFolder="$(GameDir)/BepInEx/plugins" />
  </Target>

  <Target Name="GameDir exists" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(GameDir)')"
         Text="GameDir is not set or wrong: '$(GameDir)'. Point it at the root of the game." />
  </Target>

  <Target Name="Dotnet root" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(DOTNET_ROOT)')"
         Text="DOTNET_ROOT is not set or wrong: '$(DOTNET_ROOT)'. Point it at the root of dotnet." />
  </Target>

</Project>
